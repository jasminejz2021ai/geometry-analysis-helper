# Fallback provider for questions no template matches: "dify" | "openai" | "anthropic".
# Without the matching key below, the fallback is disabled and the app uses templates only.
FALLBACK_PROVIDER=dify

# --- Dify chatflow (used when FALLBACK_PROVIDER=dify) ---
# Dify Cloud: https://api.dify.ai   |  Self-hosted: your instance base URL.
DIFY_API_BASE=https://api.dify.ai
# The App API key from your Dify app (Publish -> API Access). Starts with "app-".
DIFY_API_KEY=

# --- Direct / local LLM (used when FALLBACK_PROVIDER=openai or anthropic) ---
LLM_PROVIDER=openai
# Optional OpenAI-compatible base URL. For a free local model via Ollama:
#   LLM_API_BASE=http://localhost:11434/v1  (and LLM_MODEL=qwen3:8b, LLM_API_KEY blank)
# Leave blank to use the real OpenAI API (then set LLM_API_KEY).
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Vision model for reading photos. Local via Ollama: "qwen2.5vl:7b".
# (llama3.2-vision is unsupported by current Ollama builds.)
# For OpenAI, use a vision model like "gpt-4o".
LLM_VISION_MODEL=qwen2.5vl:7b

# Comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
