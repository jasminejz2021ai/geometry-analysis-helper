# Fallback provider for questions no template matches: "dify" | "openai" | "anthropic".
# Without the matching key below, the fallback is disabled and the app uses templates only.
# Use "openai" with Google Gemini (below) for a cheap, always-on cloud backend.
FALLBACK_PROVIDER=openai

# --- Dify chatflow (used when FALLBACK_PROVIDER=dify) ---
# Dify Cloud: https://api.dify.ai   |  Self-hosted: your instance base URL.
DIFY_API_BASE=https://api.dify.ai
# The App API key from your Dify app (Publish -> API Access). Starts with "app-".
DIFY_API_KEY=

# --- Direct / cloud / local LLM (used when FALLBACK_PROVIDER=openai or anthropic) ---
LLM_PROVIDER=openai
# RECOMMENDED (cloud, no local machine or tunnel needed): Google Gemini via its
# OpenAI-compatible endpoint. Get a free key at https://aistudio.google.com/apikey
#   LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-3.6-flash          (Gemini Flash is multimodal -> same model reads photos)
#   LLM_VISION_MODEL=gemini-3.6-flash
# Free local model via Ollama (needs a public tunnel for the deployed site):
#   LLM_API_BASE=http://localhost:11434/v1  (LLM_MODEL=qwen3:8b, LLM_VISION_MODEL=qwen2.5vl:7b, key blank)
# Leave blank to use the real OpenAI API (then set LLM_API_KEY).
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_VISION_MODEL=gemini-3.6-flash

# Comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
